<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <AvaloniaResource Include="../../App/Assets/*.png;../../App/Assets/*.jpg" Link="Assets/%(Filename)%(Extension)" />
    <Content Include="../../App/Assets/N1.mp3;../../App/Assets/NBm.mp3;../../App/Assets/iiilab_video_2.mp4;../../App/Assets/v6.mp4"
             Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../App/Assets/ApPIconsN2/Square44x44Logo.targetsize-256.png"
             Link="Assets/icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
