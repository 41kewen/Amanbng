<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Amanbng.Linux.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Noto Sans CJK SC, Noto Sans, DejaVu Sans" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#17243B" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#52637A" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="25" />
    </Style>
    <Style Selector="TextBlock.result">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#185B53" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#235DDA" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="MinWidth" Value="174" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="28" />
      <Setter Property="BorderBrush" Value="#E1E7F0" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Styles>
</Application>
